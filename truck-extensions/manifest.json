{
  "manifest_version": 3,
  "name": "Truck Route Calculator",
  "version": "1.0",

  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.google.com/maps/*",
    "https://*.timocom.com/*",
    "https://*.timocom.pl/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Open Truck Panel"
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "content_scripts": [
  {
    "matches": [
      "https://my.timocom.com/*",
      "https://*.timocom.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }
]
}